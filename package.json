{
  "name": "@easypayment/medusa-payment-braintree",
  "version": "0.0.2",
  "description": "Braintree payment provider plugin for Medusa v2 — accept credit/debit cards and ACH Direct Debit with 3D Secure, vaulting, refunds, and webhook-driven payment updates.",
  "author": "EasyPayment (https://github.com/easypayment)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easypayment/braintree-payment.git"
  },
  "homepage": "https://github.com/easypayment/braintree-payment#readme",
  "bugs": {
    "url": "https://github.com/easypayment/braintree-payment/issues"
  },
  "files": [
    ".medusa/server/**/*"
  ],
  "main": "./.medusa/server/src/index.js",
  "types": "./.medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./types": {
      "types": "./.medusa/server/src/types/index.d.ts",
      "import": "./.medusa/server/src/types/index.js",
      "require": "./.medusa/server/src/types/index.js",
      "default": "./.medusa/server/src/types/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.15.2",
    "@medusajs/cli": "^2.15.2",
    "@medusajs/framework": "^2.15.2",
    "@medusajs/icons": "^2.15.2",
    "@medusajs/medusa": "^2.15.2",
    "@medusajs/test-utils": "^2.15.2",
    "@medusajs/ui": "^4.1.5",
    "@swc/core": "^1.7.28",
    "@types/braintree": "^3.3.14",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "medusa plugin:build && node scripts/verify-publish.js",
    "test": "jest --config jest.config.cjs --runInBand",
    "plugin:dev": "medusa plugin:develop",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.15.2",
    "@medusajs/cli": "^2.13.5",
    "@medusajs/framework": "^2.15.2",
    "@medusajs/icons": "^2.15.2",
    "@medusajs/medusa": "2.15.2",
    "@medusajs/test-utils": "^2.15.2",
    "@medusajs/ui": "^4.1.5",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "braintree": "^3.38.0",
    "zod": "^3.24.0 || ^4.0.0"
  }
}
